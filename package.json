{
  "name": "google-slides-hybrid-mcp",
  "version": "1.0.0",
  "description": "Production-ready hybrid Google Slides MCP server combining API + Live Browser + Vision layers",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "google-slides-hybrid-mcp": "build/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "start:http": "node build/index.js --transport http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --transport http",
    "setup": "tsx src/cli/setup.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "cli": "tsx src/cli/index.ts",
    "get-token": "tsx src/api/getRefreshToken.ts",
    "postinstall": "node scripts/postinstall.cjs",
    "test": "vitest run",
    "test:unit": "vitest run src/tests/unit",
    "test:integration": "vitest run src/tests/integration",
    "test:e2e": "vitest run src/tests/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "google-slides",
    "presentation",
    "browser-automation",
    "vision",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "eventemitter3": "^5.0.1",
    "express": "^5.2.1",
    "googleapis": "^148.0.0",
    "helmet": "^8.1.0",
    "marked": "^15.0.0",
    "open": "^10.1.1",
    "sharp": "^0.33.0",
    "winston": "^3.17.0",
    "ws": "^8.18.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.1",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
