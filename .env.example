# ─────────────────────────────────────────────────────────────────────────────
# Google Slides Hybrid MCP Server — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required variables are marked with [REQUIRED].
# Optional variables show their default values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google OAuth 2.0 Credentials ─────────────────────────────────────────────
# [REQUIRED] Obtain these from the Google Cloud Console:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Client ID (type: Desktop app)
#   3. Enable the Google Slides API and Google Drive API
#   4. Run `npm run get-token` to complete the OAuth flow and get a refresh token

# OAuth Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# OAuth Client Secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth Refresh Token (obtained via `npm run get-token`)
GOOGLE_REFRESH_TOKEN=your-refresh-token

# ── Browser Layer Configuration ──────────────────────────────────────────────
# These settings control the live browser editing layer that communicates
# with Google Slides via the Chrome extension and WebSocket bridge.

# WebSocket port for Chrome extension communication (default: 9222)
# The Chrome extension connects to ws://localhost:<port> to relay commands.
BROWSER_WS_PORT=9222

# Screenshot output format: png, jpeg, or webp (default: png)
# PNG gives the best quality; JPEG is smaller; WebP is a good balance.
BROWSER_SCREENSHOT_FORMAT=png

# Timeout for browser operations in milliseconds (default: 30000)
# Increase this if you have a slow connection or large presentations.
BROWSER_TIMEOUT=30000

# ── Vision Layer Configuration ───────────────────────────────────────────────
# The vision layer provides design analysis, scoring, theming, and auto-fix
# capabilities powered by the sharp image processing library.

# Enable or disable the vision layer: true or false (default: true)
# Set to false if you only need API and browser tools.
VISION_ENABLED=true

# Automatically apply design fixes: true or false (default: false)
# When true, vision_auto_fix_* tools will apply fixes immediately.
# When false, they return fix plans that you apply via batch_update.
VISION_AUTO_FIX=false

# ── Logging ──────────────────────────────────────────────────────────────────

# Log level: debug, info, warn, or error (default: info)
# Use "debug" during development for verbose output.
# Use "error" in production for minimal noise.
LOG_LEVEL=info

# ── Runtime Environment ──────────────────────────────────────────────────────

# Node environment: development, production, or test (default: production)
NODE_ENV=production
